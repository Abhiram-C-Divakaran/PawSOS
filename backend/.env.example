# PawReach Backend Environment Configuration Template
# NOTE: Never commit real production secrets to version control.

# Database Configuration (PostgreSQL with PostGIS required in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pawsos

# Security & JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_key_at_least_32_characters_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Staging Database Seeding (Required only when running scripts/seed_staging.py, min 14 chars)
# STAGING_SEED_PASSWORD=your_secure_unique_staging_password_here_14chars

# CORS & Environment
# In staging/production, ENVIRONMENT must be 'staging' or 'production' and CORS_ORIGINS must be explicit.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENVIRONMENT=development

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# Storage Provider (local, s3)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Dispatch Timing & Escalation Settings
RESPONDER_LOCATION_STALE_MINUTES=30
DISPATCH_RADIUS_LEVELS=5,10,20,40
DISPATCH_OFFER_EXPIRY_SECONDS=90

# Dispatch Composite Scoring Weights (Must sum to 1.0)
DISPATCH_WEIGHT_DISTANCE=0.40
DISPATCH_WEIGHT_AVAILABILITY=0.25
DISPATCH_WEIGHT_EXPERIENCE=0.15
DISPATCH_WEIGHT_VEHICLE=0.10
DISPATCH_WEIGHT_RELIABILITY=0.10

# Maximum Concurrent Offers Per Priority
DISPATCH_MAX_OFFERS_CRITICAL=5
DISPATCH_MAX_OFFERS_URGENT=3
DISPATCH_MAX_OFFERS_MODERATE=2
DISPATCH_MAX_OFFERS_GENERAL=1

# Cookie & Rate Limiting
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_PER_MINUTE=60

# Observability
SENTRY_DSN=
