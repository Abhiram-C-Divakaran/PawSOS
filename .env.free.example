# ==============================================================================
# PawReach — Zero-Cost Free-Tier Deployment Environment Template
# ==============================================================================
# Placeholders ONLY — Do NOT commit real secrets to source control.
# Copy and populate these values in your Render Dashboard / host environment.
# ==============================================================================

ENVIRONMENT=staging
PROCESS_TYPE=all

# 1. Supabase PostgreSQL + PostGIS Connection
# Obtain exact URI from: Supabase Dashboard -> Connect -> Session pooler (Port 5432)
# NOTE: Port 5432 is Session mode (recommended for SQLAlchemy/Alembic).
# Port 6543 is Transaction mode and should NOT be used due to prepared statement limitations.
# Example format: postgresql://postgres.<project-ref>:<db-password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=<SUPABASE_POSTGRES_SESSION_POOLER_URI>

# 2. Upstash Free Redis Connection
# NOTE: Use the Redis TCP/TLS connection string from Upstash, beginning with "rediss://".
# Do NOT use the Upstash REST URL for Celery.
# Format: rediss://default:<password>@<host>:<port>?ssl_cert_reqs=required
REDIS_URL=rediss://default:<password>@<host>:<port>?ssl_cert_reqs=required

# 3. Supabase Private S3-Compatible Storage
# Format endpoint: https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=<SUPABASE_STORAGE_S3_ENDPOINT>
S3_BUCKET_NAME=<PRIVATE_BUCKET_NAME>
AWS_ACCESS_KEY_ID=<SUPABASE_S3_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<SUPABASE_S3_SECRET_KEY>
AWS_REGION=<SUPABASE_S3_REGION>
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# 4. Free-Tier Relaxed Background Scheduling (Low Redis command consumption)
DISPATCH_BEAT_INTERVAL_SECONDS=120.0
CELERY_HEARTBEAT_INTERVAL_SECONDS=60.0
CELERY_HEARTBEAT_TTL_SECONDS=180
CELERY_HEARTBEAT_THRESHOLD_SECONDS=180

# 5. Security & CORS Configuration
# Set to the exact deployed Render frontend URL (e.g. https://pawreach-frontend.onrender.com)
CORS_ORIGINS=<RENDER_FRONTEND_URL>
JWT_SECRET_KEY=<STRONG_RANDOM_SECRET_MIN_32_CHARS>
JWT_ALGORITHM=HS256
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# 6. Firebase Push Notifications (Optional — false for initial free deployment)
REQUIRE_FIREBASE=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
